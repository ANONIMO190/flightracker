<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FlightTracker — Desk ADS-B Telemetry Radar</title>
<style>
  :root {
    --bg: #09090b;
    --card: #121215;
    --card-border: #242429;
    --accent: #00FFA3;
    --accent-dim: rgba(0, 255, 163, 0.12);
    --text: #ffffff;
    --muted: #9ca3af;
    --danger: #FF453A;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; scroll-behavior: smooth; }
  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
  }

  /* NAVBAR */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(9, 9, 11, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--card-border);
    padding: 14px 24px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-weight: 900; font-size: 18px; letter-spacing: 0.5px; text-transform: uppercase;
  }
  .brand-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }
  .nav-links { display: flex; gap: 22px; align-items: center; font-size: 14px; font-weight: 600; }
  .nav-links a { color: var(--muted); text-decoration: none; transition: 0.2s; }
  .nav-links a:hover { color: #fff; }
  .btn-nav {
    background: #1C1C1E; color: #fff; border: 1px solid #333;
    padding: 8px 16px; border-radius: 10px; cursor: pointer;
    font-weight: 700; font-size: 13px; transition: 0.2s;
  }
  .btn-nav:hover { border-color: var(--accent); color: var(--accent); }
  .btn-buy-top {
    background: var(--accent); color: #000; border: none;
    padding: 8px 18px; border-radius: 10px; cursor: pointer;
    font-weight: 800; font-size: 13px;
  }

  /* HERO SECTION */
  .hero {
    max-width: 1120px; margin: 0 auto; padding: 65px 24px 50px;
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 45px; align-items: center;
  }
  .badge-avionics {
    display: inline-block; background: var(--accent-dim); color: var(--accent);
    border: 1px solid rgba(0,255,163,0.3); font-size: 11px; font-weight: 800;
    padding: 5px 12px; border-radius: 999px; letter-spacing: 1px; text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(32px, 5vw, 52px); font-weight: 900;
    line-height: 1.06; letter-spacing: -1px; margin-bottom: 18px;
  }
  .hero p { color: var(--muted); font-size: 17px; margin-bottom: 28px; max-width: 520px; }
  .hero-cta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .btn-main {
    background: var(--accent); color: #000; border: none;
    padding: 16px 30px; font-size: 16px; font-weight: 900; border-radius: 14px;
    cursor: pointer; box-shadow: 0 6px 25px rgba(0,255,163,0.22); transition: 0.2s;
    text-decoration: none; display: inline-block;
  }
  .btn-main:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,255,163,0.35); }
  .btn-outline {
    background: #18181c; color: #fff; border: 1px solid #333;
    padding: 16px 24px; font-size: 15px; font-weight: 700; border-radius: 14px;
    cursor: pointer; text-decoration: none;
  }

  /* SIMULATORE OLED INTERATTIVO */
  .oled-case {
    background: linear-gradient(145deg, #1b1b20, #0d0d10);
    border: 2px solid #2c2c34; border-radius: 26px;
    padding: 28px; box-shadow: 0 25px 60px rgba(0,0,0,0.75);
    position: relative;
  }
  .case-top-btn {
    width: 48px; height: 7px; background: #2c2c34; border-radius: 6px 6px 0 0;
    position: absolute; top: -9px; left: 50%; transform: translateX(-50%);
    cursor: pointer; transition: 0.15s;
  }
  .case-top-btn:active { top: -5px; background: var(--accent); }
  .oled-screen {
    background: #000; border: 3px solid #222; border-radius: 10px;
    height: 195px; padding: 14px 18px; font-family: "Segoe UI", Roboto, sans-serif;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .oled-top-row {
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 2px solid #fff; padding-bottom: 8px; height: 42px;
  }
  .oled-marquee-wrap { width: 78%; overflow: hidden; white-space: nowrap; position: relative; }
  .oled-marquee {
    display: inline-block; font-size: 22px; font-weight: 900; color: #fff;
    animation: scrollLeft 6.5s linear infinite;
  }
  @keyframes scrollLeft {
    0% { transform: translateX(105%); }
    100% { transform: translateX(-110%); }
  }
  .oled-page { font-family: monospace; font-size: 16px; font-weight: 800; color: #fff; }
  .oled-data-row {
    display: flex; justify-content: space-between; font-size: 16px; margin-top: 6px;
  }
  .oled-lbl { font-weight: 800; color: #fff; }
  .oled-val { color: #fff; font-variant-numeric: tabular-nums; }
  .oled-caption {
    text-align: center; font-size: 12px; color: var(--muted); margin-top: 14px;
    display: flex; justify-content: space-between; align-items: center;
  }

  /* SEZIONE CHICCHE TECNICHE */
  .section { max-width: 1120px; margin: 0 auto; padding: 60px 24px; }
  .section-title { font-size: 32px; font-weight: 900; text-align: center; margin-bottom: 10px; }
  .section-sub { color: var(--muted); text-align: center; margin-bottom: 42px; font-size: 16px; }
  .features-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;
  }
  .feat-card {
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: 18px; padding: 26px; transition: 0.25s;
  }
  .feat-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .feat-tag {
    color: var(--accent); font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; display: block;
  }
  .feat-card h3 { font-size: 20px; margin-bottom: 10px; }
  .feat-card p { color: var(--muted); font-size: 14.5px; }

  /* SEZIONE ACQUISTO E CHECKOUT */
  .checkout-grid {
    display: grid; grid-template-columns: 1fr 1.15fr; gap: 30px; margin-top: 20px;
  }
  .box-card {
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: 20px; padding: 30px;
  }
  .price-tag { font-size: 42px; font-weight: 900; color: var(--accent); margin: 12px 0; }
  .spec-list { list-style: none; margin: 18px 0; }
  .spec-list li {
    padding: 10px 0; border-bottom: 1px solid #222;
    display: flex; justify-content: space-between; font-size: 14px;
  }
  .form-group { margin-bottom: 14px; text-align: left; }
  .form-group label { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 5px; text-transform: uppercase; }
  .form-input {
    width: 100%; padding: 13px 15px; border-radius: 10px;
    border: 1px solid #2e2e36; background: #18181c; color: #fff; font-size: 15px; outline: none;
  }
  .form-input:focus { border-color: var(--accent); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* MODALE LOGIN / REGISTRAZIONE */
  .modal-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,0.8);
    backdrop-filter: blur(6px); z-index: 200;
    display: none; justify-content: center; align-items: center; padding: 20px;
  }
  .modal {
    background: #141418; border: 1px solid #2e2e36; border-radius: 20px;
    width: 100%; max-width: 420px; padding: 28px; position: relative;
  }
  .modal-tabs { display: flex; gap: 10px; margin-bottom: 20px; }
  .modal-tab {
    flex: 1; padding: 10px; text-align: center; background: #1C1C1E;
    border-radius: 10px; cursor: pointer; font-weight: 700; font-size: 14px; color: var(--muted);
  }
  .modal-tab.active { background: var(--accent); color: #000; }
  .close-modal {
    position: absolute; top: 16px; right: 20px; color: var(--muted);
    font-size: 22px; cursor: pointer; background: none; border: none;
  }

  footer {
    border-top: 1px solid var(--card-border); padding: 35px 24px;
    text-align: center; color: var(--muted); font-size: 13px; margin-top: 50px;
  }

  @media (max-width: 820px) {
    .hero, .checkout-grid { grid-template-columns: 1fr; }
    .nav-links a { display: none; }
  }
</style>
</head>
<body>

<!-- NAVBAR -->
<nav>
  <div class="brand">
    <div class="brand-dot"></div>
    <span>FLIGHT TRACKER</span>
  </div>
  <div class="nav-links">
    <a href="#chicche">Funzioni Esclusive</a>
    <a href="#specifiche">Specifiche</a>
    <a href="#ordina">Acquista</a>
    <button class="btn-nav" id="userBtn" onclick="apriModaleAuth()">👤 Accedi / Registrati</button>
    <button class="btn-buy-top" onclick="document.getElementById('ordina').scrollIntoView()">Ordina Ora</button>
  </div>
</nav>

<!-- HERO CON SIMULATORE OLED LIVE -->
<section class="hero">
  <div>
    <span class="badge-avionics">STRUMENTO TELEMETRICO DA SCRIVANIA</span>
    <h1>Il cielo sopra casa tua.<br>In tempo reale.</h1>
    <p>
      FlightTracker scansiona i transponder ADS-B degli aerei che sorvolano la tua zona e mostra compagnia, rotta, modello, quota e velocità su uno schermo OLED ad alto contrasto. Zero abbonamenti, zero limiti.
    </p>
    <div class="hero-cta">
      <a href="#ordina" class="btn-main">Acquista il Radar — 79,00 €</a>
      <a href="#chicche" class="btn-outline">Scopri le Chicche</a>
    </div>
  </div>

  <!-- SIMULATORE INTERATTIVO DELLO SCHERMO -->
  <div>
    <div class="oled-case">
      <div class="case-top-btn" onclick="cambiaVoloDemo()" title="Clicca per cambiare volo"></div>
      <div class="oled-screen">
        <div class="oled-top-row">
          <div class="oled-marquee-wrap">
            <div class="oled-marquee" id="demoTop">LUFTHANSA &nbsp;&nbsp; MUC - FCO</div>
          </div>
          <div class="oled-page" id="demoPage">1/3</div>
        </div>
        <div class="oled-data-row"><span class="oled-lbl">MOD:</span><span class="oled-val" id="demoMod">A320 NEO</span></div>
        <div class="oled-data-row"><span class="oled-lbl">ALT:</span><span class="oled-val" id="demoAlt">10972 m</span></div>
        <div class="oled-data-row"><span class="oled-lbl">VEL:</span><span class="oled-val" id="demoVel">842 km/h</span></div>
      </div>
      <div class="oled-caption">
        <span>🟢 Live OLED Simulator</span>
        <button class="btn-nav" style="padding:5px 10px; font-size:12px;" onclick="cambiaVoloDemo()">Cambia Aereo ✈️</button>
      </div>
    </div>
  </div>
</section>

<!-- LE CHICCHE TECNICHE -->
<section class="section" id="chicche">
  <h2 class="section-title">Perché è unico nel suo genere</h2>
  <p class="section-sub">Progettato in ogni dettaglio per gli appassionati di aviazione e tecnologia.</p>

  <div class="features-grid">
    <div class="feat-card">
      <span class="feat-tag">01 • MAPPA SATELLITARE</span>
      <h3>Scegli il tuo quadrante di cielo</h3>
      <p>Inquadra il QR Code sullo schermo e trascina il mirino sulla mappa satellitare dal tuo smartphone per monitorare esattamente la zona sopra la tua finestra o il tuo aeroporto preferito.</p>
    </div>
    <div class="feat-card">
      <span class="feat-tag">02 • EDITOR DRAG & DROP</span>
      <h3>Costruisci il tuo layout</h3>
      <p>Scegli tu cosa vedere su ciascuna riga trascinando i blocchi dal telefono: Compagnia, Rotta IATA, Modello, Altitudine in metri, Flight Level (FL), Velocità, Heading (HDG), Rateo V/S o Marche.</p>
    </div>
    <div class="feat-card">
      <span class="feat-tag">03 • ZERO ABBONAMENTI</span>
      <h3>Rete ADS-B illimitata + Cloud Sync</h3>
      <p>Nessun account da creare e nessuna chiave API da inserire. Il radar usa una doppia rete globale illimitata e aggiorna da solo via cloud l'elenco mondiale delle compagnie aeree e dei jet privati.</p>
    </div>
    <div class="feat-card">
      <span class="feat-tag">04 • SCHEDULER INTELLIGENTE</span>
      <h3>Orari automatici con memoria</h3>
      <p>Imposta col selettore a rullo gli orari di accensione e spegnimento. Se manca la corrente durante la notte, al ritorno dell'alimentazione il radar calcola l'ultimo stato e resta spento fino al mattino.</p>
    </div>
    <div class="feat-card">
      <span class="feat-tag">05 • PROTEZIONE HARDWARE</span>
      <h3>Anti Burn-In & Domotica</h3>
      <p>Micro-spostamento impercettibile dei pixel per proteggere il pannello OLED negli anni, orologio digitale a cielo vuoto e compatibilità con Alexa e Google Home tramite SinricPro.</p>
    </div>
    <div class="feat-card">
      <span class="feat-tag">06 • SICUREZZA LOCALE</span>
      <h3>Portale Web protetto da QR</h3>
      <p>Nessuno sulla rete può modificare le tue impostazioni senza permesso: la dashboard si sblocca solo quando fai doppio click fisico sul pulsante superiore del radar.</p>
    </div>
  </div>
</section>

<!-- ACQUISTO E SPEDIZIONE A CASA -->
<section class="section" id="ordina">
  <h2 class="section-title">Ordina il tuo FlightTracker</h2>
  <p class="section-sub">Assemblato, collaudato e spedito direttamente a casa tua pronto all'uso.</p>

  <div class="checkout-grid" id="specifiche">
    <!-- Riepilogo Prodotto -->
    <div class="box-card">
      <span class="badge-avionics">DISPONIBILITÀ IMMEDIATA</span>
      <h3 style="font-size:26px; font-weight:900;">FlightTracker Desk Edition</h3>
      <div class="price-tag">79,00 € <span style="font-size:14px; color:var(--muted); font-weight:500;">IVA e Spedizione incluse</span></div>
      <p style="color:var(--muted); font-size:14px; margin-bottom:16px;">
        Ricevi a casa il radar completo di case compatto nero opaco, display OLED da 1,3" ad alto contrasto e manuale pieghevole in formato A4.
      </p>
      <ul class="spec-list">
        <li><span>Processore</span><strong>Dual-Core 32-bit 240 MHz</strong></li>
        <li><span>Schermo</span><strong>OLED 1.3" Monocromatico</strong></li>
        <li><span>Connettività</span><strong>Wi-Fi 2.4 GHz integrato</strong></li>
        <li><span>Alimentazione</span><strong>USB Type-C (5V DC)</strong></li>
        <li><span>Aggiornamenti Compagnie</span><strong>Automatici via Cloud</strong></li>
        <li><span>Spedizione Tracciata</span><strong>Corriere Espresso (24/48h)</strong></li>
      </ul>
      <div id="storicoOrdiniBox" style="display:none; margin-top:20px; padding:14px; background:#18181c; border-radius:12px; border:1px solid #333;">
        <div style="font-size:12px; font-weight:800; color:var(--accent); text-transform:uppercase; margin-bottom:6px;">I tuoi ultimi ordini salvati</div>
        <div id="listaOrdiniUtente" style="font-size:13px; color:var(--muted);"></div>
      </div>
    </div>

    <!-- Modulo Spedizione + Pagamento Reale -->
    <div class="box-card">
      <h3 style="font-size:22px; margin-bottom:6px;">Dati di Spedizione e Pagamento</h3>
      <p style="color:var(--muted); font-size:13.5px; margin-bottom:18px;">
        Compila l'indirizzo dove vuoi ricevere il pacco. Verrai reindirizzato al pagamento sicuro con Carta, Apple Pay, Google Pay o PayPal.
      </p>

      <!-- Sostituisci tua-email@esempio.com con la tua vera email per ricevere in automatico la scheda di spedizione di ogni cliente! -->
      <form id="checkoutForm" onsubmit="procediAlPagamentoReale(event)">
        <div class="form-row">
          <div class="form-group">
            <label>Nome e Cognome *</label>
            <input type="text" id="ord_nome" class="form-input" placeholder="Mario Rossi" required>
          </div>
          <div class="form-group">
            <label>Email per Tracking *</label>
            <input type="email" id="ord_email" class="form-input" placeholder="mario@email.it" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Telefono (per il Corriere) *</label>
            <input type="tel" id="ord_tel" class="form-input" placeholder="+39 333 1234567" required>
          </div>
          <div class="form-group">
            <label>Quantità</label>
            <input type="number" id="ord_qty" class="form-input" value="1" min="1" max="5" onchange="aggiornaTotale()" required>
          </div>
        </div>

        <div class="form-group">
          <label>Indirizzo Completo (Via e Numero Civico) *</label>
          <input type="text" id="ord_via" class="form-input" placeholder="Via Roma 10, Scala B" required>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Città e Provincia *</label>
            <input type="text" id="ord_citta" class="form-input" placeholder="Bolzano (BZ)" required>
          </div>
          <div class="form-group">
            <label>CAP *</label>
            <input type="text" id="ord_cap" class="form-input" placeholder="39100" required>
          </div>
        </div>

        <div class="form-group">
          <label>Metodo di Pagamento Preferito</label>
          <select id="ord_metodo" class="form-input">
            <option value="stripe">💳 Carta di Credito / Debito / Apple Pay / Google Pay</option>
            <option value="paypal">🅿️ PayPal (Anche in 3 rate)</option>
          </select>
        </div>

        <button type="submit" class="btn-main" style="width:100%; margin-top:8px;" id="btnSubmitPay">
          Paga in sicurezza (<span id="totaleBtn">79,00 €</span>) →
        </button>
      </form>
    </div>
  </div>
</section>

<!-- MODALE REGISTRAZIONE E LOGIN CLIENTI -->
<div class="modal-backdrop" id="authModal">
  <div class="modal">
    <button class="close-modal" onclick="chiudiModaleAuth()">×</button>
    <div class="modal-tabs">
      <div class="modal-tab active" id="tabLogin" onclick="switchAuthTab('login')">Accedi</div>
      <div class="modal-tab" id="tabReg" onclick="switchAuthTab('register')">Registrati</div>
    </div>

    <!-- Form Login -->
    <form id="formLogin" onsubmit="eseguiLogin(event)">
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="log_email" class="form-input" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="log_pass" class="form-input" required>
      </div>
      <p id="authMsg" style="color:var(--danger); font-size:13px; margin-bottom:10px; display:none;"></p>
      <button type="submit" class="btn-main" style="width:100%;">Accedi al tuo Account</button>
    </form>

    <!-- Form Registrazione -->
    <form id="formReg" style="display:none;" onsubmit="eseguiRegistrazione(event)">
      <div class="form-group">
        <label>Nome e Cognome</label>
        <input type="text" id="reg_nome" class="form-input" required>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="reg_email" class="form-input" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="reg_pass" class="form-input" minlength="6" required>
      </div>
      <div class="form-group">
        <label>Indirizzo di Spedizione Predefinito</label>
        <input type="text" id="reg_via" class="form-input" placeholder="Via, Città, CAP">
      </div>
      <button type="submit" class="btn-main" style="width:100%;">Crea Account Gratuito</button>
    </form>

    <!-- Vista Utente Loggato -->
    <div id="vistaLoggato" style="display:none; text-align:center;">
      <h3 id="benvenutoNome" style="margin-bottom:6px;"></h3>
      <p id="benvenutoEmail" style="color:var(--muted); font-size:14px; margin-bottom:20px;"></p>
      <button class="btn-outline" style="width:100%;" onclick="eseguiLogout()">Esci dall'Account</button>
    </div>
  </div>
</div>

<footer>
  <p><strong>FLIGHT TRACKER</strong> — Strumento Telemetrico da Scrivania • Progettato e assemblato in Italia</p>
</footer>

<script>
  // ==========================================
  // CONFIGURAZIONE LINK DI PAGAMENTO REALI (A COSTO ZERO)
  // Inserisci qui il tuo link Stripe Payment Link o PayPal.me!
  // ==========================================
  const LINK_STRIPE_REALE = "https://buy.stripe.com/test_tuo_link";
  const LINK_PAYPAL_REALE = "https://www.paypal.com/paypalme/tuousername/";
  const TUA_EMAIL_NOTIFICA_ORDINI = "matteofiorindo2007@gmail.com";
  const PREZZO_UNITARIO = 79;

  // Simulatore OLED interattivo nella Hero
  const voliDemo = [
    { top: "LUFTHANSA    MUC - FCO", page: "1/3", mod: "A320 NEO", alt: "10972 m", vel: "842 km/h" },
    { top: "SKY ALPS    BZO - BER", page: "2/3", mod: "DASH 8-Q400", alt: "7315 m", vel: "648 km/h" },
    { top: "EMIRATES    DXB - MXP", page: "3/3", mod: "A380-800", alt: "11580 m", vel: "912 km/h" }
  ];
  let idxDemo = 0;
  function cambiaVoloDemo() {
    idxDemo = (idxDemo + 1) % voliDemo.length;
    const v = voliDemo[idxDemo];
    document.getElementById('demoTop').innerText = v.top;
    document.getElementById('demoPage').innerText = v.page;
    document.getElementById('demoMod').innerText = v.mod;
    document.getElementById('demoAlt').innerText = v.alt;
    document.getElementById('demoVel').innerText = v.vel;
  }

  function aggiornaTotale() {
    const q = parseInt(document.getElementById('ord_qty').value) || 1;
    document.getElementById('totaleBtn').innerText = (q * PREZZO_UNITARIO) + ",00 €";
  }

  // ==========================================
  // SISTEMA DI REGISTRAZIONE E LOGIN CLIENTI
  // ==========================================
  function apriModaleAuth() {
    document.getElementById('authModal').style.display = 'flex';
    aggiornaStatoUtenteUI();
  }
  function chiudiModaleAuth() {
    document.getElementById('authModal').style.display = 'none';
  }
  function switchAuthTab(tab) {
    document.getElementById('authMsg').style.display = 'none';
    if (tab === 'login') {
      document.getElementById('tabLogin').classList.add('active');
      document.getElementById('tabReg').classList.remove('active');
      document.getElementById('formLogin').style.display = 'block';
      document.getElementById('formReg').style.display = 'none';
    } else {
      document.getElementById('tabReg').classList.add('active');
      document.getElementById('tabLogin').classList.remove('active');
      document.getElementById('formReg').style.display = 'block';
      document.getElementById('formLogin').style.display = 'none';
    }
  }

  function eseguiRegistrazione(e) {
    e.preventDefault();
    const utenti = JSON.parse(localStorage.getItem('ft_users') || '[]');
    const email = document.getElementById('reg_email').value.trim().toLowerCase();
    if (utenti.find(u => u.email === email)) {
      alert("Questa email è già registrata. Effettua l'accesso.");
      return;
    }
    const nuovoUtente = {
      nome: document.getElementById('reg_nome').value.trim(),
      email: email,
      pass: document.getElementById('reg_pass').value,
      via: document.getElementById('reg_via').value.trim(),
      ordini: []
    };
    utenti.push(nuovoUtente);
    localStorage.setItem('ft_users', JSON.stringify(utenti));
    localStorage.setItem('ft_current_user', JSON.stringify(nuovoUtente));
    aggiornaStatoUtenteUI();
    chiudiModaleAuth();
  }

  function eseguiLogin(e) {
    e.preventDefault();
    const utenti = JSON.parse(localStorage.getItem('ft_users') || '[]');
    const email = document.getElementById('log_email').value.trim().toLowerCase();
    const pass = document.getElementById('log_pass').value;
    const trovato = utenti.find(u => u.email === email && u.pass === pass);
    if (!trovato) {
      const msg = document.getElementById('authMsg');
      msg.innerText = "Credenziali non valide o utente non registrato.";
      msg.style.display = 'block';
      return;
    }
    localStorage.setItem('ft_current_user', JSON.stringify(trovato));
    aggiornaStatoUtenteUI();
    chiudiModaleAuth();
  }

  function eseguiLogout() {
    localStorage.removeItem('ft_current_user');
    aggiornaStatoUtenteUI();
    chiudiModaleAuth();
  }

  function aggiornaStatoUtenteUI() {
    const user = JSON.parse(localStorage.getItem('ft_current_user') || 'null');
    const btn = document.getElementById('userBtn');
    if (user) {
      btn.innerText = "👤 " + user.nome.split(' ')[0];
      document.getElementById('ord_nome').value = user.nome || '';
      document.getElementById('ord_email').value = user.email || '';
      if (user.via && !document.getElementById('ord_via').value) {
        document.getElementById('ord_via').value = user.via;
      }
      document.querySelector('.modal-tabs').style.display = 'none';
      document.getElementById('formLogin').style.display = 'none';
      document.getElementById('formReg').style.display = 'none';
      document.getElementById('vistaLoggato').style.display = 'block';
      document.getElementById('benvenutoNome').innerText = "Ciao, " + user.nome;
      document.getElementById('benvenutoEmail').innerText = user.email;

      if (user.ordini && user.ordini.length > 0) {
        document.getElementById('storicoOrdiniBox').style.display = 'block';
        document.getElementById('listaOrdiniUtente').innerHTML = user.ordini.map(o =>
          `<div style="padding:4px 0; border-bottom:1px solid #222;">📦 ${o.data} — ${o.qty}x FlightTracker (${o.totale}€) — In preparazione</div>`
        ).join('');
      }
    } else {
      btn.innerText = "👤 Accedi / Registrati";
      document.querySelector('.modal-tabs').style.display = 'flex';
      document.getElementById('vistaLoggato').style.display = 'none';
      document.getElementById('storicoOrdiniBox').style.display = 'none';
      switchAuthTab('login');
    }
  }

  // ==========================================
  // INVIO INDIRIZZO SPEDIZIONE + REDIRECT PAGAMENTO REALE
  // ==========================================
  function procediAlPagamentoReale(e) {
    e.preventDefault();
    const qty = parseInt(document.getElementById('ord_qty').value) || 1;
    const totale = qty * PREZZO_UNITARIO;
    const metodo = document.getElementById('ord_metodo').value;

    const datiOrdine = {
      Prodotto: "FlightTracker Desk Edition",
      Quantita: qty,
      Totale_Euro: totale + ",00 EUR",
      Cliente: document.getElementById('ord_nome').value,
      Email: document.getElementById('ord_email').value,
      Telefono: document.getElementById('ord_tel').value,
      Indirizzo: document.getElementById('ord_via').value,
      Citta_Prov: document.getElementById('ord_citta').value,
      CAP: document.getElementById('ord_cap').value,
      Metodo_Scelto: metodo
    };

    // Salva nello storico dell'utente se loggato
    let user = JSON.parse(localStorage.getItem('ft_current_user') || 'null');
    if (user) {
      user.ordini = user.ordini || [];
      user.ordini.unshift({ data: new Date().toLocaleDateString('it-IT'), qty: qty, totale: totale });
      localStorage.setItem('ft_current_user', JSON.stringify(user));
    }

    document.getElementById('btnSubmitPay').innerText = "Reindirizzamento al pagamento sicuro...";

    // Invia in automatico una mail con tutti i dati di spedizione alla tua casella tramite FormSubmit (Gratuito)
    fetch("https://formsubmit.co/ajax/" + TUA_EMAIL_NOTIFICA_ORDINI, {
      method: "POST",
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(datiOrdine)
    }).finally(() => {
      if (metodo === "paypal") {
        window.location.href = LINK_PAYPAL_REALE + totale;
      } else {
        window.location.href = LINK_STRIPE_REALE;
      }
    });
  }

  aggiornaStatoUtenteUI();
</script>
</body>
</html>
